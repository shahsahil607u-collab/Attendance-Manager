# Server
PORT=5001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/attendance-manager

# JWT (used for signing access + refresh tokens; change in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Demo Seed (set to true only in development; NEVER in production)
ENABLE_DEMO_SEED=false

# SMTP Email Configuration (Gmail: use App Password from Google Account > Security)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
FROM_EMAIL=noreply@technicalteam.edu

# HOD Email
HOD_EMAIL=sahilirshad875@gmail.com

# Frontend URL (for CORS and password reset links)
FRONTEND_URL=http://localhost:5173
